generator client {
  provider = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ProductExperienceType {
  STANDARD
  CONFIGURABLE
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  ARCHIVED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  CONTENT_EDITOR
  READ_ONLY
}

enum MediaType {
  IMAGE
  VIDEO
}

enum DocumentType {
  TECHNICAL_SHEET
  INSTALLATION_MANUAL
  DIMENSION_DRAWING
  CERTIFICATE
  COMMERCIAL_DOCUMENT
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  ENGINEERING
  PRODUCTION
  QUALITY_CONTROL
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum AddressType {
  BILLING
  SHIPPING
}


enum ErpImportStatus {
  RUNNING
  COMPLETED
  SKIPPED
  FAILED
}

model Supplier {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  code             String?  @unique
  logoUrl          String?
  contactName      String?
  email            String?
  phone            String?
  website          String?
  averageLeadTime  String?
  internalNotes    String?  @db.Text
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  products         Product[]

  @@index([isActive])
}

model Category {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  path            String?
  description     String?    @db.Text
  seoTitle        String?
  seoDescription  String?    @db.Text
  imageUrl        String?
  sortOrder       Int        @default(0)
  isActive        Boolean    @default(true)
  parentId        String?
  parent          Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryTree")
  products        Product[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([parentId])
  @@index([sortOrder])
}

model Product {
  id                    String            @id
  code                  String
  supplierCode          String?
  parentCode            String?
  slug                  String            @unique
  name                  String
  shortName             String?
  description           String?           @db.Text
  detailedDescription   String?           @db.Text
  priceHt               Decimal           @db.Decimal(12, 2)
  minPriceHt            Decimal?          @db.Decimal(12, 2)
  maxPriceHt            Decimal?          @db.Decimal(12, 2)
  stock                  Int               @default(0)
  leadTime               String?
  imageReference         String?
  publicationStatus     PublicationStatus @default(DRAFT)
  sortOrder              Int               @default(0)
  featured               Boolean           @default(false)
  experienceType         ProductExperienceType @default(STANDARD)
  configuratorFamily     String?
  marketingBadges        Json?
  faq                     Json?
  videoUrls               Json?
  relatedProductCodes     Json?
  accessoryProductCodes   Json?
  seoTitle               String?
  seoDescription         String?           @db.Text
  optionSchema           Json?
  sourceData             Json?
  supplierId             String?
  categoryId             String?
  supplier               Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category               Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants               ProductVariant[]
  features               ProductFeature[]
  media                  ProductMedia[]
  documents              ProductDocument[]
  orderItems             OrderItem[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  publishedAt            DateTime?

  @@index([code])
  @@index([supplierCode])
  @@index([supplierId])
  @@index([categoryId])
  @@index([publicationStatus])
  @@index([featured])
  @@index([experienceType])
  @@index([configuratorFamily])
}

model ProductVariant {
  id              String   @id
  code            String
  supplierCode    String?
  name            String
  label           String?
  priceHt         Decimal  @db.Decimal(12, 2)
  stock           Int      @default(0)
  leadTime        String?
  imageReference  String?
  options         Json?
  sourceData      Json?
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  features        ProductVariantFeature[]
  orderItems      OrderItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([productId])
  @@index([code])
  @@index([supplierCode])
}

model ProductFeature {
  id         String   @id @default(cuid())
  label      String
  value      String
  sortOrder  Int      @default(0)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model ProductVariantFeature {
  id         String         @id @default(cuid())
  label      String
  value      String
  sortOrder  Int            @default(0)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, sortOrder])
}

model ProductMedia {
  id         String    @id @default(cuid())
  type       MediaType @default(IMAGE)
  url        String
  sourceUrl  String?
  altText    String?
  isPrimary  Boolean   @default(false)
  sortOrder  Int       @default(0)
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

model ProductDocument {
  id          String       @id @default(cuid())
  name        String
  type        DocumentType @default(OTHER)
  url         String
  sourceUrl   String?
  isPublic    Boolean      @default(true)
  sortOrder   Int          @default(0)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

model AdminUser {
  id            String       @id @default(cuid())
  email         String       @unique
  firstName     String
  lastName      String
  passwordHash  String?
  role          AdminRole    @default(READ_ONLY)
  status        UserStatus   @default(INVITED)
  lastLoginAt   DateTime?
  invitedAt     DateTime?
  activatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  auditLogs     AuditLog[]
}

model Customer {
  id          String            @id @default(cuid())
  email       String            @unique
  firstName   String?
  lastName    String?
  company     String?
  phone       String?
  vatNumber   String?
  addresses   CustomerAddress[]
  orders      Order[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model CustomerAddress {
  id          String      @id @default(cuid())
  type        AddressType
  label       String?
  company     String?
  firstName   String?
  lastName    String?
  address1    String
  address2    String?
  postalCode  String
  city        String
  country     String      @default("FR")
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders      Order[]     @relation("ShippingAddress")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
}

model Order {
  id                 String        @id @default(cuid())
  reference          String        @unique
  status             OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus      PaymentStatus @default(PENDING)
  currency           String        @default("EUR")
  subtotalHt         Decimal       @db.Decimal(12, 2)
  taxAmount          Decimal       @db.Decimal(12, 2)
  totalTtc           Decimal       @db.Decimal(12, 2)
  customerNote       String?       @db.Text
  internalNote       String?       @db.Text
  deliveryMode       String?
  requestedDate      String?
  customerId         String
  shippingAddressId  String?
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  shippingAddress    CustomerAddress? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  events             OrderEvent[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  paidAt             DateTime?
  shippedAt          DateTime?

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  name            String
  reference       String?
  quantity        Int             @default(1)
  unitPriceHt     Decimal         @db.Decimal(12, 2)
  totalHt         Decimal         @db.Decimal(12, 2)
  configuration   Json?
  productId       String?
  variantId       String?
  orderId         String
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model OrderEvent {
  id           String   @id @default(cuid())
  type         String
  title        String
  description  String?  @db.Text
  metadata     Json?
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String     @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  userId      String?
  user        AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ErpImport {
  id             String          @id @default(cuid())
  source         String
  sourceHash     String
  status         ErpImportStatus @default(RUNNING)
  snapshotDate   DateTime?
  stats          Json?
  changes        Json?
  errorMessage   String?         @db.Text
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  productRecords ErpProductRecord[]
  ouvrageRecords ErpOuvrageRecord[]
  familyRecords  ErpFamilyRecord[]

  @@index([status, startedAt])
  @@index([sourceHash])
}

model ErpFamilyRecord {
  id             String    @id @default(cuid())
  code           String    @unique
  label          String
  category       String
  ouvragesCount  Int       @default(0)
  productsCount  Int       @default(0)
  samples        Json?
  contentHash    String
  isActive       Boolean   @default(true)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastImportId   String?
  lastImport     ErpImport? @relation(fields: [lastImportId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([lastImportId])
}

model ErpProductRecord {
  id             String    @id @default(cuid())
  ref            String    @unique
  label          String
  description    String?   @db.Text
  family         String
  category       String
  costPrice      Decimal   @db.Decimal(12, 2)
  attributes     Json?
  contentHash    String
  isActive       Boolean   @default(true)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  lastImportId   String?
  lastImport     ErpImport? @relation(fields: [lastImportId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([family])
  @@index([category])
  @@index([isActive])
  @@index([lastImportId])
}

model ErpOuvrageRecord {
  id                String    @id @default(cuid())
  code              String    @unique
  label             String
  description       String?   @db.Text
  family            String
  category          String
  mainComponentCode String?
  basePrice         Decimal   @db.Decimal(12, 2)
  defaultTotal      Decimal   @db.Decimal(12, 2)
  attributes        Json?
  components        Json?
  contentHash       String
  isActive          Boolean   @default(true)
  firstSeenAt       DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  lastImportId      String?
  lastImport        ErpImport? @relation(fields: [lastImportId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([family])
  @@index([category])
  @@index([isActive])
  @@index([lastImportId])
}

